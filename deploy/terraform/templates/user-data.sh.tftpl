#!/bin/bash
set -euo pipefail

# First-boot setup for BleedStop ${environment}.
# Installs Docker so you can run deploy/production/docker-compose.prod.yml.
# Secrets stay off the image — copy .env.production yourself after login.

export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y ca-certificates curl gnupg git jq unzip

# Official Docker apt repo (Ubuntu)
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

# shellcheck disable=SC1091
. /etc/os-release
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $${VERSION_CODENAME} stable" \
  > /etc/apt/sources.list.d/docker.list

apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

usermod -aG docker ubuntu || true
systemctl enable --now docker

mkdir -p /opt/bleedstop
chown ubuntu:ubuntu /opt/bleedstop

cat >/etc/motd <<'EOF'
BleedStop staging host (Terraform)
----------------------------------
1) Put the repo in /opt/bleedstop
2) Create .env.production (never commit secrets)
3) docker compose -f deploy/production/docker-compose.prod.yml --env-file .env.production up -d --build
4) Point DNS A record for DOMAIN at this public IP
Docs: deploy/terraform/README.md
EOF

echo "BleedStop cloud-init finished at $(date -u) env=${environment}" >> /var/log/bleedstop-cloud-init.log
