PORT=3000
UNPAID_CEILING_USD=5
PAID_CEILING_USD=50
GHOST_THRESHOLD_USD=1
RAG_ENABLED=1
TENANT_ID=local-dev
# template | ollama (free local) | llm (needs OPENAI_API_KEY)
AGENT_MODE=template
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
BLEEDSTOP_URL=http://localhost:3000
APP_PORT=4000

# Multi-tenant API keys (optional). Format: key:tenant,key2:tenant2
# BLEEDSTOP_API_KEYS=demo-key:local-dev,acme-key:tenant-acme
# BLEEDSTOP_API_KEY=demo-key

# Dashboard login / roles (recommended before sharing)
# Format: username:password:role, role = viewer | operator | admin
# DASHBOARD_USERS=admin:change-this-password:admin,ops:change-this-too:operator
# Generate a random session secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DASHBOARD_SESSION_SECRET=replace-with-random-64-hex

# Slack Incoming Webhook (optional) — ghost spend kill-switch alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Real Postgres (optional): npm run db:up  (host port 5434)
DATABASE_URL=postgres://bleedstop:bleedstop@localhost:5434/bleedstop
REDIS_URL=redis://localhost:6379

# LIVE OpenAI (optional — real money). Use a restricted key + hard budget limit.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# BLEEDSTOP_VENDOR_KEY_ID=oa-live-key

# Stripe test mode (optional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Token-aware LLM guard (send estimatedTokens = prompt tokens + max output tokens in /decide)
# LLM_USD_PER_1K_TOKENS=0.01
# LLM_MAX_TOKENS_UNPAID=32000
# LLM_VELOCITY_MAX_PER_MIN=60
# Structured logs: one JSON line per /decide on stdout
# LOG_FORMAT=json

# Per-tenant policy file (validated at boot): see config/policy.example.yaml
# POLICY_FILE=config/policy.example.yaml
# Network signals (ADR-0003)
# SUBNET_POOL_MIN_ACTORS=10
# SUBNET_POOL_CEILING_USD=5
# SUBNET_POOL_PER_ACTOR_USD=0.1
# ASN_SPREAD_MODE=shadow
# SUBNET_ALLOWLIST=203.0.113.0/24
# ASN_ALLOWLIST=AS64500
# Agent guard
# AGENT_GUARD_MODE=enforce
# Control plane protection
# DECIDE_RATE_PER_SEC=2000
# DECIDE_BURST=4000
# STRICT_READS=1
# API keys may be stored hashed: sha256:<hex sha256 of key>:tenant
# Redis multi-instance: atomic Lua ceiling is on by default with REDIS_URL
# REDIS_ATOMIC=1
# OpenTelemetry (off unless set)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=bleedstop
